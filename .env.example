# Fill these for a Supabase project. Never commit real values.
# Project URL and publishable key are used by the browser app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=

# Database connection string is used only to apply and validate migrations.
# Keep it out of browser code and out of chat messages.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Short-lived Management API token for setup tasks only.
SUPABASE_ACCESS_TOKEN=

# Google OAuth Web application credentials; server-side configuration only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Approved one-user account for the bootstrap script.
SUPABASE_OWNER_EMAIL=
SUPABASE_OWNER_TIME_ZONE=Asia/Kolkata
